FROM ghcr.io/cyber-dojo-languages/zig:21a25fe@sha256:d84bff6850fff0b5ae74ce11b374e68013c78097212ed5bbd27fac43c200fd80
LABEL maintainer=jon@jaggersoft.com

# A kata's test-run reads a zig cache warmed here instead of recompiling zig's
# standard library and test runner in every fresh container. The script explains
# where the warming has to happen and why, and fails the build if a kata would
# not hit the cache.
COPY install.sh .
RUN bash ./install.sh && rm ./install.sh
